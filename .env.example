# Public website origin. Keep deployment-specific values out of Git.
NEXT_PUBLIC_SITE_URL=https://ninjamelon.cz

# Supabase project. The anon key is public; the service-role key is server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-to-server bridge. Use a unique random secret on the backend and plugins.
NINJAMELON_BRIDGE_URL=
NINJAMELON_BRIDGE_KEY_ID=
NINJAMELON_BRIDGE_SECRET=

# Preview only: simulate LuckPerms authorization for one exact Supabase Auth UUID.
# Requires VERCEL_ENV=preview; never enable in Production.
NINJAMELON_PREVIEW_TEST_MODE=false
NINJAMELON_PREVIEW_TEST_USER_ID=

# Secure server session signing key; generate at least 32 random bytes.
SESSION_SIGNING_SECRET=

# Upstash Redis REST endpoint/token. Sensitive writes fail closed if absent.
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_REDIS_TOKEN=

# Optional public community integration; blank means unavailable, not a fake link.
DISCORD_INVITE_URL=
